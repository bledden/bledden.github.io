---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import ptxHero from '../../assets/getpoppy-ptx-hero.png';
import upstreamingHero from '../../assets/getpoppy-upstreaming-hero.png';

// Explicit ordering by quality ranking
const postOrder = [
	'triton-msl',                // 1st - Triton Metal backend, verified byte-identical portability
	'recall',                    // 2nd - cross-session memory plugin, systems + measured cost
	'arrwdb-optimization',       // 3rd - 341x optimization, top-7 ann-benchmarks
	'noisy-student',             // 4th - 4 experiments, consensus self-training finding
	'context-distillation',      // 5th - novel distribution cliff finding
	'open-character-training',   // 6th - strong replication
	'memorization-study',        // 7th - clean theory validation
	'cai-base-model',            // 8th - pipeline works, data scale issue
	'gan-joke-generation',       // 9th - honest failure analysis
	'cross-project-meta-analysis', // 10th - synthesis piece
];

const allPosts = await getCollection('blog');
const localCards = postOrder
	.map(id => allPosts.find(p => p.id === id))
	.filter(Boolean)
	.map(p => ({
		title: p.data.title,
		pubDate: p.data.pubDate,
		heroImage: p.data.heroImage,
		href: `/blog/${p.id}/`,
		external: false,
	}));

// Mirror cards for the Second Nature (getpoppy.app) posts: hero, headline, date.
// Clicking opens the original post there; the content is not cloned locally.
const externalCards = [
	{
		title: 'Writing PTX for Consumer Blackwell',
		pubDate: new Date('2026-07-08T12:00:00Z'),
		heroImage: ptxHero,
		href: 'https://getpoppy.app/blog/writing-ptx-for-consumer-blackwell',
		external: true,
	},
	{
		title: 'Four Months Upstreaming Consumer Blackwell',
		pubDate: new Date('2026-06-22T12:00:00Z'),
		heroImage: upstreamingHero,
		href: 'https://getpoppy.app/blog/four-months-upstreaming-consumer-blackwell',
		external: true,
	},
];

// Featured (first) local post stays first; the two mirror cards follow it.
const cards = [localCards[0], ...externalCards, ...localCards.slice(1)];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;
				word-break: normal;
				overflow-wrap: normal;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.4em;
				}
				.title {
					font-size: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						cards.map((card) => (
							<li>
								<a
									href={card.href}
									target={card.external ? '_blank' : undefined}
									rel={card.external ? 'noopener' : undefined}
								>
									{card.heroImage && (
										<Image width={720} height={360} src={card.heroImage} alt="" />
									)}
									<h4 class="title">{card.title}</h4>
									<p class="date">
										<FormattedDate date={card.pubDate} />
										{card.external && <span class="ext"> · Second Nature blog ↗</span>}
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
